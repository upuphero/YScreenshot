<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>YScreenshot.Capture</AssemblyName>
    <RootNamespace>YScreenshot.Capture</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Region capture delegates the selection UI to the overlay project; every other
         capture mode reads virtual-screen geometry from YScreenshot.Overlay.MonitorHelper. -->
    <ProjectReference Include="..\YScreenshot.Overlay\YScreenshot.Overlay.csproj" />
  </ItemGroup>

</Project>
